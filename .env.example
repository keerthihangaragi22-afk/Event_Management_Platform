# ============================================================
# EVENT MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local for local development
# OR enter these values in Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# -------------------- REQUIRED --------------------

# Neon PostgreSQL (get from https://console.neon.tech)
# Use the POOLED connection string for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Use the DIRECT (non-pooled) connection string for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js secret (generate a long random string)
# You can generate one at: https://generate-secret.vercel.app/32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
NEXTAUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Public URL of your deployed app (no trailing slash)
# Example: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------- EMAIL (Resend) --------------------

# Get from https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Must be a verified domain/sender in Resend
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="The Legacy Circle"

# -------------------- OPTIONAL --------------------

# Image storage - Cloudinary (recommended free tier)
# Get from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Or use a generic image storage
IMAGE_STORAGE_PROVIDER="cloudinary"
IMAGE_STORAGE_API_KEY=""
IMAGE_STORAGE_BASE_URL=""

# -------------------- NOTES --------------------
# 1. DATABASE_URL and DATABASE_URL_UNPOOLED are REQUIRED
# 2. AUTH_SECRET / NEXTAUTH_SECRET are REQUIRED
# 3. RESEND_API_KEY is required for sending emails
# 4. Never commit real secrets to GitHub
# 5. After setting variables in Vercel, redeploy the project
